{
	"manifest_version": 3,
	"name": "React Story Facebook V5",
	"description": "Cải tiến thêm cảm xúc Story Facebook",
	"version": "1.0.5",
	"icons": {
		"16": "icons/icon16.png",
		"48": "icons/icon48.png",
		"128": "icons/icon128.png"
	},
	"background": {
		"service_worker": "background.js"
	},
	"content_scripts": [
		{
			"matches": ["https://www.facebook.com/*"],
			"css": ["styles.css"],
			"js": ["content.js"]
		}
	],
	"web_accessible_resources": [
		{
			"resources": ["story.js"],
			"matches": ["https://www.facebook.com/*"]
		}
	],
	"permissions": [
		"activeTab",
		"scripting"
	],
	"host_permissions": [
		"https://www.facebook.com/*",
		"https://raw.githubusercontent.com/*"
	]
}