{
	"manifest_version": 3,
    "name": "React Story Facebook V5",
    "description": "Cải tiến thêm cảm xúc Story Facebook",
    "version": "1.0.5",
    "icons": {
        "16": "icons/icon16.png",
        "24": "icons/icon24.png",
        "32": "icons/icon32.png",
        "64": "icons/icon64.png",
        "128": "icons/icon128.png",
        "256": "icons/icon256.png",
        "512": "icons/icon512.png"
    },
	"background": {
		"service_worker": "background.js"
	},
	"content_scripts": [
		{
			"matches": ["https://www.facebook.com/*"],
			"css": ["styles.css"],
			"js": ["content.js"]
		}
	],
	"web_accessible_resources": [
		{
			"resources": ["story.js", "js/notification.js", "data/emoji.json"],
			"matches": ["https://www.facebook.com/*"]
		}
	]
}
